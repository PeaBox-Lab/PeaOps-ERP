# PeaOps backend environment (copy to .env for local dev)
PEAOPS_ENVIRONMENT=development
PEAOPS_DATABASE_URL=sqlite:///./peaops.db
PEAOPS_SECRET_KEY=change-me-at-least-32-chars-long-please
PEAOPS_DEFAULT_CURRENCY=INR
PEAOPS_ACCESS_TOKEN_MINUTES=15
PEAOPS_ALLOWED_ORIGINS=http://localhost:5173
PEAOPS_TRUST_PROXY_HEADERS=false
PEAOPS_AUTO_CREATE_SCHEMA=true